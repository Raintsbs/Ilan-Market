{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=/app/data/ilanmarket.db"
  },
  "App": {
    "FrontendUrl": "https://ilan-market.vercel.app",
    "ApiUrl": "https://ilan-market-production-b980.up.railway.app"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://ilan-market.vercel.app",
      "https://emlak-portfolio.vercel.app",
      "http://localhost:3000"
    ]
  },
  "Storage": {
    "Provider": "Local"
  },
  "Email": {
    "Enabled": true,
    "PickupDirectory": "email-pickup",
    "From": "noreply@ilanmarket.staging"
  },
  "Sms": {
    "Provider": "dev"
  },
  "Payments": {
    "AllowDemo": true,
    "PreferredProvider": "iyzico"
  },
  "Seed": {
    "RunOnStartup": true,
    "RunCategoryCatalog": true,
    "RunLegalPages": true,
    "ImportLocalAds": true
  },
  "Captcha": {
    "Enabled": false
  }
}
